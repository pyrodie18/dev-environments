#!/usr/bin/env bash
set -euo pipefail

project_slug="${1:?usage: bootstrap-codex-home <project-slug>}"
codex_home="${CODEX_HOME:-${HOME}/.codex}"

install -d -m 0700 "${codex_home}"

if [[ ! -e "${codex_home}/config.toml" ]]; then
    sed "s/__PROJECT_SLUG__/${project_slug}/g" /usr/local/share/codex-container/config.toml \
        > "${codex_home}/config.toml"
    chmod 0600 "${codex_home}/config.toml"
fi

for profile in fast deep-review; do
    if [[ ! -e "${codex_home}/${profile}.config.toml" ]]; then
        install -m 0600 "/usr/local/share/codex-container/${profile}.config.toml" \
            "${codex_home}/${profile}.config.toml"
    fi
done

